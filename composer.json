{
    "name": "kode/limiting",
    "description": "PHP 8.4+ 限流器，支持令牌桶、漏桶、滑动窗口、滑动窗口计数器、固定窗口计数器与多规则组合限流，内置内存/APCu/Redis/Memcached/PDO 存储与分布式并发控制",
    "type": "library",
    "version": "3.0.0",
    "license": "Apache-2.0",
    "keywords": [
        "limiting",
        "rate-limit",
        "rate-limiter",
        "throttle",
        "token-bucket",
        "leaky-bucket",
        "sliding-window",
        "semaphore",
        "concurrency",
        "distributed"
    ],
    "authors": [
        {
            "name": "Kode Team",
            "email": "382601296@qq.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kode\\Limiting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Limiting\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-redis": "分布式限流（推荐，支持 Lua 原子脚本、Sentinel、Cluster）",
        "ext-apcu": "单机多进程共享限流状态，无需外部中间件",
        "ext-memcached": "基于 Memcached 的分布式限流",
        "ext-pdo": "基于 MySQL / PostgreSQL / SQLite 的分布式限流"
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyze": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
